{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "omnisource-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(omnisource_http_requests_total[5m]))", "legendFormat": "requests/sec", "refId": "A"}],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "omnisource-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(omnisource_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "API p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "omnisource-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum(rate(omnisource_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(omnisource_http_requests_total[5m])), 1)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "HTTP 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "omnisource-prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (type, status) (increase(omnisource_jobs_total[1h]))", "legendFormat": "{{type}} {{status}}", "refId": "A"}],
      "title": "Background job outcomes (1h)",
      "type": "timeseries"
    }
  ],
