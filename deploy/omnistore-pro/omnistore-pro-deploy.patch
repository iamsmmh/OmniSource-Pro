+# Netlify configuration for OmniStore.
+#
+# OmniStore is a server-rendered Next.js app (search, feeds, sitemap, reporting
+# and caching are server-side by design), so it needs the Next.js runtime rather
+# than static publishing.
+
+[build]
+  command = "npm run build"
+  publish = ".next"
+
+[build.environment]
+  # package.json declares engines.node >= 22.12.0.
+  NODE_VERSION = "22"
+
+# Netlify installs this automatically for Next.js sites; declaring it keeps the
+# requirement visible and pinned in review.
+[[plugins]]
+  package = "@netlify/plugin-nextjs"
diff --git a/src/config/site.test.ts b/src/config/site.test.ts
new file mode 100644
index 0000000..4b18ce5
--- /dev/null
+++ b/src/config/site.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from "vitest";
+
+import { resolveSiteUrl } from "./site";
+
+/**
+ * A deployment must be correct on first boot: canonical URLs, Open Graph tags
+ * and sitemap.xml all derive from the site origin. `NEXT_PUBLIC_SITE_URL` is the
+ * documented override, and the hosting platforms' own variables keep a fresh
+ * deploy correct when nobody configured anything.
+ */
+describe("resolveSiteUrl", () => {
+  it("prefers the explicit override and strips a trailing slash", () => {
+    expect(
+      resolveSiteUrl({ NEXT_PUBLIC_SITE_URL: "https://omnistore.example/", VERCEL_URL: "ignored.vercel.app" }),
+    ).toBe("https://omnistore.example");
+  });
+
+  it("accepts an override written without a scheme", () => {
+    expect(resolveSiteUrl({ NEXT_PUBLIC_SITE_URL: "omnistore.example" })).toBe(
+      "https://omnistore.example",
+    );
+  });
+
+  it("uses Vercel's scheme-less VERCEL_URL", () => {
+    expect(resolveSiteUrl({ VERCEL_URL: "omnistore-pro.vercel.app" })).toBe(
+      "https://omnistore-pro.vercel.app",
+    );
+  });
+
+  it("prefers Netlify's deploy-specific origin, then the production URL", () => {
+    expect(
+      resolveSiteUrl({
+        DEPLOY_PRIME_URL: "https://deploy-preview-7--omnistore.netlify.app",
+        URL: "https://omnistore.netlify.app",
+      }),
+    ).toBe("https://deploy-preview-7--omnistore.netlify.app");
+
+    expect(resolveSiteUrl({ URL: "https://omnistore.netlify.app/" })).toBe(
+      "https://omnistore.netlify.app",
+    );
+  });
+
+  it("ignores blank values and falls back to localhost", () => {
+    expect(
+      resolveSiteUrl({ NEXT_PUBLIC_SITE_URL: "  ", VERCEL_URL: "", DEPLOY_PRIME_URL: "", URL: "" }),
+    ).toBe("http://localhost:3000");
+  });
+
+  it("never produces a trailing-slash-only or scheme-less origin", () => {
+    expect(resolveSiteUrl({})).toMatch(/^https?:\/\/[^/]+$/);
+  });
+});
