+/**
+ * Normalises an origin: trims whitespace, drops trailing slashes and adds
+ * `https://` to scheme-less platform hosts such as Vercel's `VERCEL_URL`.
+ * An empty value stays empty — that is meaningful for `omnisourceUrl`, where
+ * empty means "use the bundled feed".
+ */
 function normaliseUrl(value: string) {
-  return value.replace(/\/+$/, "");
+  const trimmed = value.trim().replace(/\/+$/, "");
+  if (!trimmed) return "";
+  return /^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
+}
+
+/**
+ * Public origin used by canonical URLs, Open Graph tags, sitemap.xml and
+ * robots.txt.
+ *
+ * `NEXT_PUBLIC_SITE_URL` always wins, but when it is unset — the normal case
+ * for a first deploy — the hosting platform's own variable is used, so a fresh
+ * Vercel or Netlify deployment is correct without touching the dashboard:
+ *
+ *   Vercel   VERCEL_URL        `my-app.vercel.app` (scheme-less)
+ *   Netlify  DEPLOY_PRIME_URL  deploy-specific origin; `URL` is production
+ *
+ * Local development falls back to http://localhost:3000.
+ */
+export function resolveSiteUrl(
+  env: Record<string, string | undefined> = process.env,
+): string {
+  const candidates = [
+    env.NEXT_PUBLIC_SITE_URL,
+    env.NEXT_PUBLIC_VERCEL_URL ?? env.VERCEL_URL,
+    env.DEPLOY_PRIME_URL,
+    env.URL,
+  ];
+
+  for (const candidate of candidates) {
+    const resolved = normaliseUrl(candidate ?? "");
+    if (resolved) return resolved;
+  }
+
+  return "http://localhost:3000";
 }
 
