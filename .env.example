# OmniSource production configuration template
#
# Copy to .env, replace EVERY value marked REQUIRED, then restrict the file:
#   cp .env.example .env && chmod 600 .env
# Never commit .env. Prefer your cloud provider's secret manager in production.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=OmniSource
APP_VERSION=0.1.0
APP_ENV=production
LOG_LEVEL=INFO
API_PORT=8000

# -----------------------------------------------------------------------------
# PostgreSQL (REQUIRED; Compose consumes these to construct DATABASE_URL)
# -----------------------------------------------------------------------------
POSTGRES_DB=omnisource
POSTGRES_USER=omnisource
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://omnisource:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@localhost:5432/omnisource
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false
BACKUP_DIR=./data/backups
BACKUP_KEEP=7

# -----------------------------------------------------------------------------
# Redis and Celery
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Search (REQUIRED in production)
# -----------------------------------------------------------------------------
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_MEILISEARCH_KEY
MEILISEARCH_INDEX_NAME=omnisource_apps

# -----------------------------------------------------------------------------
# API and integration security (REQUIRED in production)
# API_KEYS is comma-separated; keep it distinct from SECRET_KEY.
# -----------------------------------------------------------------------------
SECRET_KEY=REPLACE_WITH_A_32_PLUS_CHARACTER_RANDOM_SERVICE_SECRET
API_KEYS=REPLACE_WITH_A_LONG_RANDOM_OMNISTORE_INTEGRATION_KEY
API_AUTH_REQUIRED=false
API_RATE_LIMIT=100
API_RESPONSE_CACHE_TTL=60
API_SEARCH_CACHE_TTL=30
API_CORS_ORIGINS=https://store.example.com

# -----------------------------------------------------------------------------
# Signed feeds (REQUIRED in production)
# Generate a base64 Ed25519 seed as documented in docs/DEPLOYMENT.md.
# -----------------------------------------------------------------------------
FEEDS_DIR=./data/feeds
FEEDS_VERSION=v1
FEED_GENERATION_INTERVAL=3600
FEED_SIGNING_PRIVATE_KEY=REPLACE_WITH_A_BASE64_ED25519_32_BYTE_SEED
FEED_SIGNING_PUBLIC_KEY=
FEED_ALLOW_EPHEMERAL_SIGNING=false

# -----------------------------------------------------------------------------
# Source credentials (optional, but strongly recommended for source quotas)
# -----------------------------------------------------------------------------
GH_TOKEN=
GH_RATE_LIMIT=5000
GH_REQUEST_TIMEOUT=30
GH_RETRY_COUNT=3
GITLAB_TOKEN=
CODEBERG_TOKEN=
FORGEJO_TOKEN=
HOMEBREW_API_URL=https://formulae.brew.sh/api
FDROID_API_URL=https://f-droid.org/api/v1
FLATHUB_API_URL=https://flathub.org/api/v1
SOURCE_HEALTH_CHECK_INTERVAL=300
SOURCE_HEALTH_CHECK_TIMEOUT=15

# -----------------------------------------------------------------------------
# Inbound webhooks (optional; set a distinct high-entropy secret per provider)
# -----------------------------------------------------------------------------
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_GITLAB=
WEBHOOK_SECRET_GITEA=

# -----------------------------------------------------------------------------
# Security scanners (optional)
# VirusTotal only receives existing artifact SHA-256 values; binaries are never
# uploaded by OmniSource. YARA only scans bytes supplied by controlled workers.
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_API_URL=https://www.virustotal.com/api/v3
YARA_RULES_DIR=

# -----------------------------------------------------------------------------
# Object storage for feed distribution (optional)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FEEDS_PREFIX=feeds

# -----------------------------------------------------------------------------
# Semantic-search provider (optional)
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_API_URL=
AI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
SYNC_INTERVAL_HOURS=6
VALIDATION_INTERVAL_HOURS=12
SYNC_SKIP_UNCHANGED=true
SYNC_MAX_AGE_HOURS=168
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_GRAFANA_PASSWORD
