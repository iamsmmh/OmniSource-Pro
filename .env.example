# OmniSource Configuration
# Copy this file to .env and fill in the values

# ============================================
# Application Settings
# ============================================
APP_NAME=OmniSource
APP_VERSION=0.1.0
APP_ENV=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omnisource
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# Meilisearch Configuration
# ============================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me-in-production
MEILISEARCH_INDEX_NAME=omnisource_apps

# ============================================
# GitHub API Configuration
# ============================================
GH_TOKEN=your-github-personal-access-token
GH_RATE_LIMIT=5000
GH_REQUEST_TIMEOUT=30
GH_RETRY_COUNT=3

# ============================================
# Other Source Tokens
# ============================================
GITLAB_TOKEN=your-gitlab-personal-access-token
CODEBERG_TOKEN=your-codeberg-personal-access-token
FDROID_API_URL=https://f-droid.org/api/v1
FLATHUB_API_URL=https://flathub.org/api/v1

# ============================================
# S3-Compatible Storage (Optional)
# ============================================
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=omnisource-feeds
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1
S3_FEEDS_PREFIX=feeds

# ============================================
# AI Provider (Optional)
# ============================================
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1

# ============================================
# API Server Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4
API_RATE_LIMIT=100
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:*

# ============================================
# Feed Configuration
# ============================================
FEEDS_DIR=./data/feeds
FEEDS_VERSION=v1
FEED_GENERATION_INTERVAL=3600

# ============================================
# Security Configuration
# ============================================
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Discovery Configuration
# ============================================
DISCOVERY_BATCH_SIZE=100
DISCOVERY_MAX_REPOS=100000
DISCOVERY_MIN_STARS=0

# ============================================
# Sync Configuration
# ============================================
SYNC_INTERVAL_HOURS=6
VALIDATION_INTERVAL_HOURS=12
